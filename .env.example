# Copy to .env and `export` / load it yourself. Never commit real values.
WADIYA_DB_PATH=data/wadiya.db
WADIYA_INDEX_PATH=data/wadiya_index.db
WADIYA_SEEDS_PATH=wadiya/config/seeds.yaml
WADIYA_USER_AGENT=WadiyaBot/0.1 (+https://wadiya.com/bot)

# Admin: generate with `python -m wadiya hash-password`
WADIYA_ADMIN_PASSWORD_HASH=
# Session signing key, >= 32 chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
WADIYA_SECRET_KEY=
# Set to false ONLY for local http:// development
WADIYA_COOKIE_SECURE=true
