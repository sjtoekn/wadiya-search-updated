    def list_discovered_sites(
        self,
        status: str | None = None,
        limit: int = 100,
        *,
        eligible_only: bool = False,
    ) -> list:
        limit = max(1, min(int(limit), 1000))
        now = now_iso()

        with self._conn() as c:
            if eligible_only:
                rows = c.execute(
                    """
                    SELECT ds.*
                    FROM discovered_sites ds
                    LEFT JOIN discovery_domains dd ON dd.domain = ds.domain
                    WHERE (
                        ds.status='pending'
                        OR (
                            ds.status='failed'
                            AND (ds.next_attempt_at IS NULL OR ds.next_attempt_at<=?)
                        )
                    )
                    AND COALESCE(dd.admission, ds.admission, 'auto')='auto'
                    ORDER BY ds.id ASC
                    LIMIT ?
                    """,
                    (now, limit),
                ).fetchall()
            elif status is None:
                rows = c.execute(
                    "SELECT * FROM discovered_sites "
                    "ORDER BY id DESC LIMIT ?",
                    (limit,),
                ).fetchall()
            else:
                rows = c.execute(
                    "SELECT * FROM discovered_sites "
                    "WHERE status=? ORDER BY id DESC LIMIT ?",
                    (status, limit),
                ).fetchall()

            return [dict(row) for row in rows]

    def discovery_registry_stats(self) -> dict:
        """Return aggregate counts for the admin discovery dashboard."""
        with self._conn() as c:
            total = c.execute(
                "SELECT COUNT(*) FROM discovered_sites"
            ).fetchone()[0]

            status_rows = c.execute(
                "SELECT status, COUNT(*) AS count "
                "FROM discovered_sites GROUP BY status ORDER BY status"
            ).fetchall()

            source_rows = c.execute(
                "SELECT source, COUNT(*) AS count "
                "FROM discovered_sites GROUP BY source ORDER BY source"
            ).fetchall()

            return {
                "total": total,
                "by_status": {
                    row["status"]: row["count"] for row in status_rows
                },
                "by_source": {
                    row["source"]: row["count"] for row in source_rows
                },
            }

    def set_discovery_domain_admission(
        self,
        domain: str,
        admission: str,
    ) -> int:
        if admission not in ("auto", "quarantine", "blocked"):
            raise ValueError("invalid discovery domain admission")

        domain = domain.strip().lower().rstrip(".")
        if not domain:
            raise ValueError("invalid discovery domain")

        now = now_iso()

        with self._conn(write=True) as c:
            row = c.execute(
                "SELECT risk_score, risk_reason FROM discovery_domains WHERE domain=?",
                (domain,),
            ).fetchone()

            risk_score = float(row["risk_score"] or 0) if row else 0.0
            risk_reason = row["risk_reason"] if row else "admin_override"

            c.execute(
                """
                INSERT INTO discovery_domains (
                  domain, admission, risk_score, risk_reason,
                  first_seen_at, updated_at
                )
                VALUES (?,?,?,?,?,?)
                ON CONFLICT(domain) DO UPDATE SET
                  admission=excluded.admission,
                  updated_at=excluded.updated_at
                """,
                (
                    domain,
                    admission,
                    risk_score,
                    risk_reason,
                    now,
                    now,
                ),
            )

            cur = c.execute(
                """
                UPDATE discovered_sites
                SET admission=?,
                    approved_at=CASE
                      WHEN ?='auto' THEN ?
                      ELSE approved_at
                    END,
                    blocked_at=CASE
                      WHEN ?='blocked' THEN ?
                      ELSE blocked_at
                    END,
                    last_seen_at=?
                WHERE domain=?
                """,
                (
                    admission,
                    admission,
                    now,
                    admission,
                    now,
                    now,
                    domain,
                ),
            )
            return int(cur.rowcount)


    def list_discovered_sites_admin(
        self,
        *,
        status: str | None = None,
        source: str | None = None,
        query: str | None = None,
        limit: int = 100,
        offset: int = 0,
    ) -> list:
        """List discovery registry rows for the admin dashboard."""
        limit = max(1, min(int(limit), 100))
        offset = max(0, int(offset))

        where = []
        params = []

        if status:
            where.append("status=?")
            params.append(status)

        if source:
            where.append("source=?")
            params.append(source)

        if query:
            like = "%" + query.strip() + "%"
            where.append("(url LIKE ? OR domain LIKE ?)")
            params.extend([like, like])

        sql = "SELECT * FROM discovered_sites"
        if where:
            sql += " WHERE " + " AND ".join(where)

        sql += " ORDER BY id DESC LIMIT ? OFFSET ?"
        params.extend([limit, offset])

        with self._conn() as c:
            rows = c.execute(sql, params).fetchall()
            return [dict(row) for row in rows]

