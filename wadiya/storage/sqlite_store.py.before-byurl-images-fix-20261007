CREATE INDEX IF NOT EXISTS idx_users_status ON users(status);
-- Google identity index is created by migration 7 after the column exists.
"""

_RUN_COLS = ("attempted", "fetched", "robots_blocked", "failed", "stored",
             "duplicates", "fetch_ms_total", "fetch_count", "duration_s")
_DOC_COLS = ("url", "canonical_url", "domain", "title", "description", "headings", "content",
             "language", "status", "content_hash", "crawled_at", "updated_at", "nosnippet")
_COUNTED = ("done", "duplicate", "noindex")   # statuses that consumed a page of the domain budget
QUERY_LOG_KEEP = 10_000

# Database schema version. Increment this when a new migration is added.
SCHEMA_VERSION = 9


def _doc(row: sqlite3.Row) -> Document:
    return Document(**{k: row[k] for k in row.keys()})


class SQLiteStorage(Storage):
    def __init__(self, path: str):
        if path == ":memory:":
            raise ValueError("use a file path; connections are per-operation")
        self.path = str(path)
        Path(self.path).parent.mkdir(parents=True, exist_ok=True)

    @contextmanager
    def _conn(self, write: bool = False):
        conn = sqlite3.connect(self.path, timeout=30, isolation_level=None)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA busy_timeout=30000")
        try:
            if write:
                conn.execute("BEGIN IMMEDIATE")
            yield conn
            if write:
                conn.execute("COMMIT")
        except BaseException:
            if write and conn.in_transaction:
                conn.execute("ROLLBACK")
            raise
        finally:
            conn.close()

    def init(self) -> None:
        with self._conn() as c:
            c.execute("PRAGMA journal_mode=WAL")
            c.executescript(SCHEMA)

            current_version = int(
                c.execute("PRAGMA user_version").fetchone()[0]
            )

            if current_version > SCHEMA_VERSION:
                raise RuntimeError(
                    f"database schema version {current_version} is newer "
                    f"than supported version {SCHEMA_VERSION}"
                )

            # Migration 1: add lifecycle failure tracking to older databases.
            # The CREATE TABLE schema already contains this column for new DBs,
            # so this only runs when upgrading an older schema.
            if current_version < 1:
                cols = {
                    r[1]
                    for r in c.execute("PRAGMA table_info(documents)")
                }
                if "fail_count" not in cols:
                    c.execute(
                        "ALTER TABLE documents "
                        "ADD COLUMN fail_count INTEGER NOT NULL DEFAULT 0"
                    )

                c.execute("PRAGMA user_version = 1")
                current_version = 1

            # Migration 2: automatic discovery registry.
            if current_version < 2:
                c.execute(
                    """
                    CREATE TABLE IF NOT EXISTS discovered_sites (
                      id INTEGER PRIMARY KEY AUTOINCREMENT,
                      url TEXT NOT NULL UNIQUE,
                      domain TEXT NOT NULL,
                      source TEXT NOT NULL,
                      status TEXT NOT NULL DEFAULT 'pending',
                      first_seen_at TEXT NOT NULL,
                      last_seen_at TEXT NOT NULL,
                      last_crawled_at TEXT,
                      crawl_count INTEGER NOT NULL DEFAULT 0,
                      failure_count INTEGER NOT NULL DEFAULT 0,
                      last_error TEXT
                    )
                    """
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS "
                    "idx_discovered_sites_domain "
                    "ON discovered_sites(domain)"
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS "
                    "idx_discovered_sites_status "
                    "ON discovered_sites(status, id)"
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS "
                    "idx_discovered_sites_source "
                    "ON discovered_sites(source, id)"
                )
                c.execute("PRAGMA user_version = 2")
                current_version = 2

            # Migration 3: publisher snippet suppression.
            if current_version < 3:
                cols = {
                    r[1]
                    for r in c.execute("PRAGMA table_info(documents)")
                }
                if "nosnippet" not in cols:
                    c.execute(
                        "ALTER TABLE documents "
                        "ADD COLUMN nosnippet INTEGER NOT NULL DEFAULT 0"
                    )
                c.execute("PRAGMA user_version = 3")
                current_version = 3

            # Migration 4: retry scheduling for failed discovered sites.
            if current_version < 4:
                cols = {
                    r[1]
                    for r in c.execute("PRAGMA table_info(discovered_sites)")
                }
                if "next_attempt_at" not in cols:
                    c.execute(
                        "ALTER TABLE discovered_sites "
                        "ADD COLUMN next_attempt_at TEXT"
                    )

                url_cols = {
                    row["name"]
                    for row in c.execute("PRAGMA table_info(urls)").fetchall()
                }
                if "next_crawl_at" not in url_cols:
                    c.execute(
                        "ALTER TABLE urls ADD COLUMN next_crawl_at TEXT"
                    )

                c.execute("PRAGMA user_version = 4")
                current_version = 4

            # Migration 5: per-domain freshness policies.
            if current_version < 5:
                c.execute(
                    """
                    CREATE TABLE IF NOT EXISTS domain_freshness (
                      domain TEXT PRIMARY KEY,
                      interval_seconds REAL NOT NULL,
                      updated_at TEXT NOT NULL
                    )
                    """
                )
                c.execute("PRAGMA user_version = 5")
                current_version = 5

            # Migration 6: public user accounts.
            if current_version < 6:
                c.execute(
                    """
                    CREATE TABLE IF NOT EXISTS users (
                      id INTEGER PRIMARY KEY AUTOINCREMENT,
                      email TEXT NOT NULL UNIQUE COLLATE NOCASE,
                      password_hash TEXT NOT NULL,
                      display_name TEXT NOT NULL DEFAULT '',
                      status TEXT NOT NULL DEFAULT 'active',
                      created_at TEXT NOT NULL,
                      updated_at TEXT NOT NULL
                    )
                    """
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS idx_users_status ON users(status)"
                )
                c.execute("PRAGMA user_version = 6")
                current_version = 6

            # Migration 7: Google OAuth identity.
            if current_version < 7:
                cols = {
                    r[1]
                    for r in c.execute("PRAGMA table_info(users)")
                }
                if "google_subject" not in cols:
                    c.execute("ALTER TABLE users ADD COLUMN google_subject TEXT")
                c.execute(
                    "CREATE UNIQUE INDEX IF NOT EXISTS idx_users_google_subject "
                    "ON users(google_subject) WHERE google_subject IS NOT NULL"
                )
                c.execute("PRAGMA user_version = 7")
                current_version = 7

            # Migration 8: scalable discovery admission / risk controls.
            if current_version < 8:
                cols = {
                    r[1]
                    for r in c.execute("PRAGMA table_info(discovered_sites)")
                }
                additions = {
                    "risk_score": "REAL NOT NULL DEFAULT 0",
                    "admission": "TEXT NOT NULL DEFAULT 'auto'",
                    "risk_reason": "TEXT",
                    "approved_at": "TEXT",
                    "blocked_at": "TEXT",
                }
                for name, definition in additions.items():
                    if name not in cols:
                        c.execute(
                            f"ALTER TABLE discovered_sites ADD COLUMN {name} {definition}"
                        )

                c.execute(
                    "CREATE INDEX IF NOT EXISTS idx_discovered_sites_admission "
                    "ON discovered_sites(admission, id)"
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS idx_discovered_sites_risk "
                    "ON discovered_sites(risk_score, id)"
                )
                c.execute(
                    """
                    CREATE TABLE IF NOT EXISTS discovery_domains (
                      domain TEXT PRIMARY KEY,
                      admission TEXT NOT NULL DEFAULT 'auto',
                      risk_score REAL NOT NULL DEFAULT 0,
                      risk_reason TEXT,
                      first_seen_at TEXT NOT NULL,
                      updated_at TEXT NOT NULL
                    )
                    """
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS idx_discovery_domains_admission "
                    "ON discovery_domains(admission, domain)"
                )
                c.execute("PRAGMA user_version = 8")
                current_version = 8

            # Safety repair: schema version 8 may already be recorded
            # while discovery_domains is missing from an older DB.
            c.execute(
                """
                CREATE TABLE IF NOT EXISTS discovery_domains (
                  domain TEXT PRIMARY KEY,
                  admission TEXT NOT NULL DEFAULT 'auto',
                  risk_score REAL NOT NULL DEFAULT 0,
                  risk_reason TEXT,
                  first_seen_at TEXT NOT NULL,
                  updated_at TEXT NOT NULL
                )
                """
            )
            c.execute(
                "CREATE INDEX IF NOT EXISTS idx_discovery_domains_admission "
                "ON discovery_domains(admission, domain)"
            )

            # Migration 9: persist crawled image candidates separately from documents.
            if current_version < 9:
                c.execute(
                    """
                    CREATE TABLE IF NOT EXISTS document_images (
                      id INTEGER PRIMARY KEY AUTOINCREMENT,
                      document_id INTEGER NOT NULL,
                      image_url TEXT NOT NULL,
                      source_page_url TEXT NOT NULL,
                      source_domain TEXT NOT NULL,
                      alt_text TEXT NOT NULL DEFAULT '',
                      title TEXT NOT NULL DEFAULT '',
                      position INTEGER NOT NULL DEFAULT 0,
                      created_at TEXT NOT NULL,
                      UNIQUE(document_id, image_url),
                      FOREIGN KEY(document_id) REFERENCES documents(id) ON DELETE CASCADE
                    )
                    """
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS "
                    "idx_document_images_document "
                    "ON document_images(document_id)"
                )
                c.execute(
                    "CREATE INDEX IF NOT EXISTS "
                    "idx_document_images_domain "
                    "ON document_images(source_domain)"
                )
                c.execute("PRAGMA user_version = 9")
                current_version = 9

            if current_version != SCHEMA_VERSION:
                raise RuntimeError(
                    f"database migration incomplete: "
                    f"version {current_version}, expected {SCHEMA_VERSION}"
                )

    # ------------------------------------------------------------------ users
    def get_user_by_google_subject(self, google_subject: str) -> Optional[User]:
        with self._conn() as c:
            r = c.execute(
                "SELECT * FROM users WHERE google_subject=?",
                (google_subject,),
            ).fetchone()
            return User(**dict(r)) if r else None

    def link_google_subject(self, user_id: int, google_subject: str,
                            reset_password_hash: Optional[str] = None) -> Optional[User]:
        """Link a Google identity. If reset_password_hash is given, the password is replaced
        in the SAME transaction (used to neutralise a password set by an unverified registrant)."""
        now = now_iso()
        with self._conn(write=True) as c:
            c.execute(
                "UPDATE users SET google_subject=?, password_hash=COALESCE(?, password_hash), "
                "updated_at=? WHERE id=?",
                (google_subject, reset_password_hash, now, user_id),
            )
            r = c.execute("SELECT * FROM users WHERE id=?", (user_id,)).fetchone()
            return User(**dict(r)) if r else None

    def create_user(self, email: str, password_hash: str, display_name: str) -> User:
        now = now_iso()
        with self._conn(write=True) as c:
            cur = c.execute(
                "INSERT INTO users (email,password_hash,display_name,created_at,updated_at) "
                "VALUES (?,?,?,?,?)",
                (email.strip().lower(), password_hash, display_name.strip(), now, now),
            )
            return User(cur.lastrowid, email.strip().lower(), password_hash,
                        display_name.strip(), now, now, "active")

    def get_user_by_email(self, email: str) -> Optional[User]:
        with self._conn() as c:
            r = c.execute(
                "SELECT * FROM users WHERE email=? COLLATE NOCASE",
                (email.strip().lower(),),
            ).fetchone()
            return User(**dict(r)) if r else None

    def get_user(self, user_id: int) -> Optional[User]:
        with self._conn() as c:
            r = c.execute("SELECT * FROM users WHERE id=?", (user_id,)).fetchone()
            return User(**dict(r)) if r else None

    def update_user_profile(self, user_id: int, display_name: str) -> Optional[User]:
        now = now_iso()
        with self._conn(write=True) as c:
            c.execute(
                "UPDATE users SET display_name=?, updated_at=? WHERE id=?",
                (display_name.strip(), now, user_id),
            )
            r = c.execute("SELECT * FROM users WHERE id=?", (user_id,)).fetchone()
            return User(**dict(r)) if r else None

    # ------------------------------------------------------------------ documents
    @staticmethod
    def _replace_document_images(c, document_id: int, images) -> None:
        c.execute(
            "DELETE FROM document_images WHERE document_id=?",
            (document_id,),
        )

        now = now_iso()
        for position, image in enumerate(images or []):
            if not isinstance(image, dict):
                continue

            image_url = str(image.get("image_url") or "").strip()
            if not image_url:
                continue

            c.execute(
                """
                INSERT OR IGNORE INTO document_images (
                  document_id,
                  image_url,
                  source_page_url,
                  source_domain,
                  alt_text,
                  title,
                  position,
                  created_at
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    document_id,
                    image_url,
                    str(image.get("source_page_url") or "").strip(),
                    str(image.get("source_domain") or "").strip(),
                    str(image.get("alt_text") or "").strip(),
                    str(image.get("title") or "").strip(),
                    position,
                    now,
                ),
            )

    @staticmethod
    def _delete_document_images(c, document_ids) -> None:
        ids = [int(i) for i in document_ids if i is not None]
        if not ids:
            return
        placeholders = ",".join("?" * len(ids))
        c.execute(
            f"DELETE FROM document_images WHERE document_id IN ({placeholders})",
            ids,
        )

    def get_document_images(self, document_id: int) -> list:
        with self._conn() as c:
            rows = c.execute(
                """
                SELECT image_url, source_page_url, source_domain,
                       alt_text, title, position
                FROM document_images
                WHERE document_id=?
                ORDER BY position, id
                """,
                (document_id,),
            ).fetchall()
            return [dict(row) for row in rows]

    def search_images(self, query: str, limit: int = 50, offset: int = 0) -> list:
        query = (query or "").strip()
        if not query:
            return []

        # Treat the user's query as literal text, not a SQL LIKE pattern.
        escaped = query.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
        pattern = f"%{escaped}%"

        limit = max(1, int(limit))
        offset = max(0, int(offset))

        with self._conn() as c:
            rows = c.execute(
                """
                SELECT
                  di.id,
                  di.document_id,
                  di.image_url,
                  di.source_page_url,
                  di.source_domain,
                  di.alt_text,
                  di.title,
                  d.title AS page_title,
                  d.description AS page_description
                FROM document_images di
                JOIN documents d ON d.id = di.document_id
                WHERE d.status='ok'
                  AND (
                    di.alt_text LIKE ? ESCAPE '\\'
                    OR di.title LIKE ? ESCAPE '\\'
                    OR d.title LIKE ? ESCAPE '\\'
                    OR d.description LIKE ? ESCAPE '\\'
                    OR d.content LIKE ? ESCAPE '\\'
                  )
                ORDER BY di.id DESC
                LIMIT ? OFFSET ?
                """,
                (
                    pattern,
                    pattern,
                    pattern,
                    pattern,
                    pattern,
                    limit,
                    offset,
                ),
            ).fetchall()

            return [dict(row) for row in rows]

    # ------------------------------------------------------------------ documents
    def save_document(self, doc: Document) -> SaveResult:
        now = now_iso()
        vals = {k: getattr(doc, k) for k in _DOC_COLS}
        with self._conn(write=True) as c:
            ex = c.execute("SELECT id, url, content_hash, status FROM documents WHERE canonical_url=?",
                           (doc.canonical_url,)).fetchone()
            if ex:
                active = ex["status"] == "ok"
                if ex["url"] != doc.url:
                    # Same canonical page reached via another URL: the canonical URL itself wins,
                    # otherwise this is a duplicate.
                    clash = c.execute("SELECT 1 FROM documents WHERE url=? AND id<>?", (doc.url, ex["id"])).fetchone()
                    if clash or (active and doc.url != doc.canonical_url):
                        return SaveResult("duplicate", ex["id"])
                elif active and ex["content_hash"] == doc.content_hash:
                    c.execute(
                        "UPDATE documents SET crawled_at=?, fail_count=0, nosnippet=? WHERE id=?",
                        (now, int(bool(doc.nosnippet)), ex["id"]),
                    )
                    self._replace_document_images(c, ex["id"], doc.images)
                    return SaveResult("unchanged", ex["id"])
                self._update(c, ex["id"], vals, now)
                self._replace_document_images(c, ex["id"], doc.images)
                return SaveResult("updated" if active else "reactivated", ex["id"])

            # only ACTIVE documents can make a new page a duplicate
            if c.execute("SELECT 1 FROM documents WHERE content_hash=? AND url<>? AND status='ok'",
                         (doc.content_hash, doc.url)).fetchone():
                return SaveResult("duplicate", None)

            byurl = c.execute("SELECT id, status FROM documents WHERE url=?", (doc.url,)).fetchone()
            if byurl:   # same URL, canonical changed
                self._update(c, byurl["id"], vals, now)
                return SaveResult("updated" if byurl["status"] == "ok" else "reactivated", byurl["id"])

            cur = c.execute(
                f"INSERT INTO documents ({','.join(_DOC_COLS)}) VALUES ({','.join('?' * len(_DOC_COLS))})",
                [vals[k] for k in _DOC_COLS])
            self._replace_document_images(c, cur.lastrowid, doc.images)
            return SaveResult("inserted", cur.lastrowid)

    @staticmethod
    def _match_active(c, urls, by_canonical: bool):
        urls = [u for u in dict.fromkeys(urls) if u]
        if not urls:
            return []
        q = ",".join("?" * len(urls))
        cond = f"url IN ({q})" + (f" OR canonical_url IN ({q})" if by_canonical else "")
        return c.execute(f"SELECT id, fail_count FROM documents WHERE status='ok' AND ({cond})",
                         urls + (urls if by_canonical else [])).fetchall()

    @staticmethod
    def _deactivate(c, ids, status: str, now: str) -> None:
        c.execute(f"UPDATE documents SET status=?, content='', headings='', description='', fail_count=0, "
                  f"indexed_at=NULL, updated_at=? WHERE id IN ({','.join('?' * len(ids))})", [status, now] + list(ids))

    def deactivate_document(self, urls, status: str, by_canonical: bool = True) -> list:
        with self._conn(write=True) as c:
            ids = [r["id"] for r in self._match_active(c, urls, by_canonical)]
            if ids:
                self._deactivate(c, ids, status, now_iso())
                self._delete_document_images(c, ids)
            return ids

    def record_fetch_failure(self, urls, threshold: int) -> list:
        dropped, now = [], now_iso()
        with self._conn(write=True) as c:
            for r in self._match_active(c, urls, True):
                n = r["fail_count"] + 1
                if n >= threshold:
                    self._deactivate(c, [r["id"]], "unreachable", now)
                    dropped.append(r["id"])
                else:
                    c.execute("UPDATE documents SET fail_count=? WHERE id=?", (n, r["id"]))
        return dropped

    @staticmethod
    def _update(c, doc_id: int, vals: dict, now: str) -> None:
        cols = [k for k in _DOC_COLS if k not in ("crawled_at", "updated_at")]
        sets = ",".join(f"{k}=?" for k in cols)
        c.execute(f"UPDATE documents SET {sets}, crawled_at=?, updated_at=?, indexed_at=NULL, fail_count=0 WHERE id=?",
                  [vals[k] for k in cols] + [now, now, doc_id])

    def get_documents(self, ids: Sequence[int]) -> dict:
        ids = list(ids)
        if not ids:
            return {}
        with self._conn() as c:
            rows = c.execute(f"SELECT * FROM documents WHERE id IN ({','.join('?' * len(ids))})", ids)
            return {r["id"]: _doc(r) for r in rows}

    def get_document_by_url(self, url: str) -> Optional[Document]:
        with self._conn() as c:
            row = c.execute(
                "SELECT * FROM documents WHERE (url=? OR canonical_url=?) AND status='ok' LIMIT 1",
                (url, url),
            ).fetchone()
            return _doc(row) if row else None

    def documents_needing_index(self, limit: int) -> list:
        with self._conn() as c:
            return [_doc(r) for r in c.execute(
                "SELECT * FROM documents WHERE indexed_at IS NULL ORDER BY id LIMIT ?", (limit,))]

    def mark_indexed(self, ids: Sequence[int]) -> None:
        ids = list(ids)
        if ids:
            with self._conn(write=True) as c:
                c.execute(f"UPDATE documents SET indexed_at=? WHERE id IN ({','.join('?' * len(ids))})",
                          [now_iso()] + ids)

    def reset_indexed(self) -> None:
        with self._conn(write=True) as c:
            c.execute("UPDATE documents SET indexed_at=NULL")

    def count_documents(self) -> int:
        with self._conn() as c:
            return c.execute("SELECT count(*) FROM documents WHERE status='ok'").fetchone()[0]

    def count_domains(self) -> int:
        with self._conn() as c:
            return c.execute("SELECT count(DISTINCT domain) FROM documents WHERE status='ok'").fetchone()[0]

    def get_domain_discovery(self, domain: str) -> dict | None:
        with self._conn() as c:
            summary = c.execute(
                "SELECT domain, count(*) AS page_count, "
                "min(crawled_at) AS first_crawled, max(crawled_at) AS last_crawled "
                "FROM documents WHERE status='ok' AND domain=? "
                "GROUP BY domain",
                (domain,),
            ).fetchone()

            if not summary:
                return None

            pages = c.execute(
                "SELECT url, title, description, language, crawled_at "
                "FROM documents WHERE status='ok' AND domain=? "
                "ORDER BY id",
                (domain,),
            ).fetchall()

            return {
                "domain": summary["domain"],
                "page_count": summary["page_count"],
                "first_crawled": summary["first_crawled"],
                "last_crawled": summary["last_crawled"],
                "pages": [dict(row) for row in pages],
            }

    # ---------------------------------------------------------- discovery registry
    def register_discovered_site(
        self,
        url: str,
        domain: str,
        source: str,
        status: str = "pending",
    ) -> bool:
        admission, risk_score, risk_reason = discovery_admission(url)
        now = now_iso()

        with self._conn(write=True) as c:
            existing = c.execute(
                "SELECT id FROM discovered_sites WHERE url=?",
                (url,),
            ).fetchone()

            if existing:
                c.execute(
                    "UPDATE discovered_sites SET last_seen_at=? WHERE url=?",
                    (now, url),
                )
                return False

            domain_row = c.execute(
                "SELECT admission, risk_score, risk_reason "
                "FROM discovery_domains WHERE domain=?",
                (domain,),
            ).fetchone()

            if domain_row:
                admission = domain_row["admission"]
                risk_score = float(domain_row["risk_score"] or 0)
                risk_reason = domain_row["risk_reason"]
            else:
                c.execute(
                    """
                    INSERT INTO discovery_domains (
                      domain, admission, risk_score, risk_reason,
                      first_seen_at, updated_at
                    )
                    VALUES (?,?,?,?,?,?)
                    """,
                    (
                        domain,
                        admission,
                        risk_score,
                        risk_reason,
                        now,
                        now,
                    ),
                )

            c.execute(
                """
                INSERT INTO discovered_sites (
                  url, domain, source, status, risk_score, admission,
                  risk_reason, first_seen_at, last_seen_at
                )
                VALUES (?,?,?,?,?,?,?,?,?)
                """,
                (
                    url,
                    domain,
                    source,
                    status,
                    risk_score,
                    admission,
                    risk_reason,
                    now,
                    now,
                ),
            )
            return True

