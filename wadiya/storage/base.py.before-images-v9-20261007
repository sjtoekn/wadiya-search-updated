"""Storage interface + models. Nothing here knows about SQLite, crawling or ranking."""
from __future__ import annotations

from abc import ABC, abstractmethod
from dataclasses import dataclass
from datetime import datetime, timezone
from typing import Optional, Sequence


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


@dataclass
class Document:
    id: Optional[int]
    url: str
    canonical_url: str
    domain: str
    title: str
    description: str
    content: str
    language: Optional[str]
    status: str
    content_hash: str
    crawled_at: str
    updated_at: str
    headings: str = ""            # extra field: heading text, newline-separated
    indexed_at: Optional[str] = None
    fail_count: int = 0           # consecutive failed crawls (reset on success)
    nosnippet: bool = False       # publisher requests that search results omit the snippet


@dataclass
class User:
    id: Optional[int]
    email: str
    password_hash: str
    display_name: str
    created_at: str
    updated_at: str
    status: str = "active"
    google_subject: Optional[str] = None


@dataclass
class QueueItem:
    id: int
    url: str
    domain: str
    depth: int
    attempts: int


@dataclass
class SaveResult:
    outcome: str                  # inserted | updated | reactivated | unchanged | duplicate
    doc_id: Optional[int]


class Storage(ABC):
    @abstractmethod
    def init(self) -> None: ...

    # ---- documents ----
    @abstractmethod
    def save_document(self, doc: Document) -> SaveResult: ...
    @abstractmethod
    def deactivate_document(self, urls: Sequence[str], status: str, by_canonical: bool = True) -> list:
        """Make active documents matching these URLs non-searchable (status != 'ok'); returns affected ids."""
    @abstractmethod
    def record_fetch_failure(self, urls: Sequence[str], threshold: int) -> list:
        """Count a failed crawl against active documents; deactivate ('unreachable') at `threshold` in a row."""
    @abstractmethod
    def get_documents(self, ids: Sequence[int]) -> dict: ...
    @abstractmethod
    def get_document_by_url(self, url: str) -> Optional[Document]: ...
    @abstractmethod
    def documents_needing_index(self, limit: int) -> list: ...
    @abstractmethod
    def mark_indexed(self, ids: Sequence[int]) -> None: ...
    @abstractmethod
    def reset_indexed(self) -> None: ...
    @abstractmethod
    def count_documents(self) -> int: ...
    @abstractmethod
    def count_domains(self) -> int: ...

    # ---- users ----
    @abstractmethod
    def create_user(self, email: str, password_hash: str, display_name: str) -> User: ...
    @abstractmethod
    def get_user_by_email(self, email: str) -> Optional[User]: ...
    @abstractmethod
    def get_user(self, user_id: int) -> Optional[User]: ...
    @abstractmethod
    def get_user_by_google_subject(self, google_subject: str) -> Optional[User]: ...
    @abstractmethod
    def link_google_subject(self, user_id: int, google_subject: str,
                            reset_password_hash: Optional[str] = None) -> Optional[User]: ...
    @abstractmethod
    def update_user_profile(self, user_id: int, display_name: str) -> Optional[User]: ...

    # ---- URL queue ----
    @abstractmethod
    def enqueue(self, url: str, domain: str, depth: int, force: bool = False) -> bool: ...
    @abstractmethod
    def claim_next(self, exclude_domains: Sequence[str] = ()) -> Optional[QueueItem]: ...
    @abstractmethod
    def mark_url(self, url: str, status: str, http_status: Optional[int] = None,
                 error: Optional[str] = None,
                 next_crawl_at: Optional[str] = None) -> None: ...
    @abstractmethod
    def get_url_attempts(self, url: str) -> int: ...
    @abstractmethod
    def queue_size(self) -> int: ...
    @abstractmethod
    def queue_counts(self) -> dict: ...
    @abstractmethod
    def domain_crawled_count(self, domain: str) -> int: ...
    @abstractmethod
    def domain_url_count(self, domain: str) -> int: ...
    @abstractmethod
    def requeue_stale(self) -> int: ...
    @abstractmethod
    def requeue_due_urls(self) -> int: ...
    @abstractmethod
    def get_domain_freshness(self, domain: str) -> Optional[float]: ...
    @abstractmethod
    def reset_queue(self) -> None: ...

    # ---- discovery registry ----
    @abstractmethod
    def register_discovered_site(self, url: str, domain: str, source: str,
                                 status: str = "pending") -> bool: ...
    @abstractmethod
    def list_discovered_sites(self, status: Optional[str] = None,
                              limit: int = 100,
                              *,
                              eligible_only: bool = False) -> list: ...
    @abstractmethod
    def get_discovered_site(self, url: str) -> Optional[dict]: ...
    @abstractmethod
    def mark_discovered_site_crawled(self, url: str, success: bool,
                                     error: Optional[str] = None,
                                     next_attempt_at: Optional[str] = None) -> None: ...
    @abstractmethod
    def set_discovery_domain_admission(self, domain: str, admission: str) -> None: ...

    # ---- crawl metrics ----
    @abstractmethod
    def start_run(self) -> int: ...
    @abstractmethod
    def update_run(self, run_id: int, stats: dict) -> None: ...
    @abstractmethod
    def finish_run(self, run_id: int, stats: dict, state: str) -> None: ...
    @abstractmethod
    def log_crawl_event(self, run_id: Optional[int], url: str, outcome: str,
                        http_status: Optional[int], fetch_ms: Optional[float],
                        error: Optional[str]) -> None: ...
    @abstractmethod
    def last_run(self) -> Optional[dict]: ...
    @abstractmethod
    def recent_crawl_errors(self, limit: int = 15) -> list: ...

    # ---- search metrics ----
    @abstractmethod
    def log_query(self, query: str, result_count: int, latency_ms: float) -> None: ...
    @abstractmethod
    def search_stats(self) -> dict: ...
    @abstractmethod
    def recent_queries(self, limit: int = 15) -> list: ...
