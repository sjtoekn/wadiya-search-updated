<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Search – Wadiya.com</title>
  <meta name="description" content="Search the web discovered by Wadiya.com.">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="flow" id="flow" hidden></div>

  <header class="top">
    <a class="mark" href="/" id="markLink" aria-label="Wadiya.com home">wadiya<span>.com</span></a>

    <form id="searchForm" class="box" role="search" autocomplete="off">
      <input
        id="q"
        name="q"
        type="search"
        maxlength="200"
        placeholder="Search a website, topic, place, or business"
        aria-label="Search a website, topic, place, or business"
      >
      <button type="submit">Discover</button>
    </form>
  </header>

  <main class="search-layout">
    <section class="search-main" aria-label="Search results">
      <p class="lede"></p>
      <div id="status" class="status" role="status" aria-live="polite"></div>
      <div id="results" class="results"></div>
      <nav id="pager" class="pager" aria-label="Pagination"></nav>
    </section>

    <aside class="search-sidebar" aria-label="Search information">
      <section class="sidebar-card top-source-card" id="topSourceCard">
        <div class="sidebar-eyebrow">Top source</div>
        <div class="top-source-content" id="topSourceContent">
          <div class="top-source-favicon" aria-hidden="true">W</div>
          <div class="top-source-copy">
            <strong>Wadiya Search</strong>
            <p>Discover useful websites from the pages Wadiya has found.</p>
          </div>
        </div>
        <a class="sidebar-link" id="topSourceLink" href="/" hidden>Visit source →</a>
      </section>

      <section class="sidebar-card">
        <div class="sidebar-eyebrow">Related searches</div>
        <div class="related-searches" id="relatedSearches"></div>
      </section>

      <section class="sidebar-ad" aria-label="Advertisement">
        <div class="sidebar-ad-label">Advertisement</div>
        <div class="ad-250">
          <div class="ad-250-inner">
            <strong>250 × 250</strong>
            <span>Advertisement</span>
          </div>
        </div>
      </section>
    </aside>
  </main>

  <script src="/static/app.js"></script>
</body>
</html>
