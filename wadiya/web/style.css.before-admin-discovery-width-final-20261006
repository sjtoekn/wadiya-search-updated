}

.admin-discovery-filters button:hover {
  border-color: #c9d3d8;
  background: #fafbfb;
}

.admin-discovery-page .tablewrap {
  border: 1px solid #e1e7ea;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 2px 10px rgba(23, 42, 70, 0.035);
}

.admin-discovery-page table {
  min-width: 1150px;
}

.admin-discovery-page th {
  white-space: nowrap;
  background: #f7f9fa;
}

.admin-discovery-page td,
.admin-discovery-page th {
  padding: 0.75rem 0.8rem;
}

.admin-discovery-page tbody tr:hover {
  background: #fffafa;
}

.admin-discovery-page td:nth-child(4) {
