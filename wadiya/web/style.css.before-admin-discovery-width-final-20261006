    padding: 1.25rem 1rem 2rem;
  }
}

/* Admin discovery — readable 1440px table */
.admin-discovery-page .tablewrap {
  overflow-x: auto;
  overflow-y: visible;
  -webkit-overflow-scrolling: touch;
}

.admin-discovery-page table {
  width: 100%;
  min-width: 1280px;
  table-layout: fixed;
}

.admin-discovery-page th,
.admin-discovery-page td {
  box-sizing: border-box;
  line-height: 1.45;
  vertical-align: top;
  overflow: visible;
  text-overflow: clip;
}

.admin-discovery-page th {
  white-space: nowrap;
}

.admin-discovery-page td {
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: normal;
}

/* URL */
.admin-discovery-page th:nth-child(1),
.admin-discovery-page td:nth-child(1) {
  width: 23%;
}

/* Domain */
.admin-discovery-page th:nth-child(2),
.admin-discovery-page td:nth-child(2) {
  width: 11%;
}

/* Source */
.admin-discovery-page th:nth-child(3),
.admin-discovery-page td:nth-child(3) {
  width: 8%;
}

/* Status */
.admin-discovery-page th:nth-child(4),
.admin-discovery-page td:nth-child(4) {
  width: 8%;
  white-space: nowrap;
}

/* First seen */
.admin-discovery-page th:nth-child(5),
.admin-discovery-page td:nth-child(5) {
  width: 11%;
}

/* Last crawled */
.admin-discovery-page th:nth-child(6),
.admin-discovery-page td:nth-child(6) {
  width: 11%;
}

/* Failures */
.admin-discovery-page th:nth-child(7),
.admin-discovery-page td:nth-child(7) {
  width: 6%;
  white-space: nowrap;
}

/* Next retry */
.admin-discovery-page th:nth-child(8),
.admin-discovery-page td:nth-child(8) {
  width: 10%;
}

/* Last error */
.admin-discovery-page th:nth-child(9),
.admin-discovery-page td:nth-child(9) {
  width: 12%;
  max-width: none;
  color: #68757d;
}

/* Keep long URLs readable without breaking every character */
.admin-discovery-page td:nth-child(1) a {
  display: inline;
  overflow-wrap: anywhere;
  word-break: break-word;
}

@media (max-width: 900px) {
  .admin-discovery-page table {
    min-width: 1200px;
  }
}

