:root {
  /* Color tokens */
  --color-bg: #e8ecea;
  --color-surface: #f6f8f7;
  --color-text: #0e2a30;
  --color-text-muted: #4f656a;
  --color-text-subtle: #25393e;
  --color-border: #c4cfcb;
  --color-primary: #0b6b73;
  --color-primary-bright: #4fd1c5;
  --color-visited: #5a4a86;
  --color-danger: #9b2c2c;
  --color-white: #fff;
  --color-highlight: rgba(79, 209, 197, .35);
  --color-action-soft: #f7f0c9;
  --color-action-soft-hover: #eee3a8;
  --color-focus-ring: rgba(79, 209, 197, .45);

  /* Typography tokens */
  --font-serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
  --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-body-size: 16px;
  --line-body: 1.5;

  /* Spacing tokens */
  --space-1: .25rem;
  --space-2: .5rem;
  --space-3: .75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-7: 2rem;
  --space-8: 3rem;
  --space-9: 4rem;

  /* Radius tokens */
  --radius-xs: 2px;
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 10px;
  --radius-pill: 999px;

  /* Border tokens */
  --border-thin: 1px;
  --border-strong: 1.5px;

  /* Shadow tokens */
  --shadow-focus: 0 0 0 3px var(--color-focus-ring);

  /* Layout tokens */
  --content-narrow: 22rem;
  --content-search: 42rem;
  --content-home: 40rem;
  --content-default: 46rem;
  --content-wide: 60rem;
  --breakpoint-mobile: 560px;

  /* Existing public aliases retained during the token migration */
  --bg: var(--color-bg);
  --panel: var(--color-surface);
  --ink: var(--color-text);
  --muted: var(--color-text-muted);
  --line: var(--color-border);
  --water: var(--color-primary);
  --water-bright: var(--color-primary-bright);
  --visited: var(--color-visited);
  --err: var(--color-danger);
  --serif: var(--font-serif);
  --sans: var(--font-sans);
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: var(--font-body-size)/var(--line-body) var(--font-sans); min-height: 100vh; }
a { color: var(--water); }
a:visited { color: var(--visited); }

.top { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-3) var(--space-6); padding: 1rem var(--space-5); background: transparent; border-bottom: 0; position: relative; }
.mark { font: var(--weight-bold) var(--text-brand)/var(--line-tight) var(--serif); letter-spacing: -.02em; color: var(--ink) !important; text-decoration: none; }
.mark span { font-weight: var(--weight-regular); color: var(--water); }
.box {
  display: flex;
  flex: 1 1 22rem;
  max-width: var(--content-search);
  border: 1px solid rgba(14, 42, 48, .16);
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, .96);
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(14, 42, 48, .07);
}
body:not(.home) .box {
  flex: 0 1 var(--content-search);
}

body:not(.home) .home-intro,
body:not(.home) .home-hint,
body:not(.home) .channel {
  display: none;
}

.box:focus-within {
  border-color: rgba(11, 107, 115, .48);
  box-shadow:
    0 0 0 3px rgba(79, 209, 197, .16),
    0 8px 24px rgba(14, 42, 48, .08);
}
a:focus-visible,
button:focus-visible,
input:focus-visible {
  outline: none;
  box-shadow: var(--shadow-focus);
}

.box input { flex: 1; min-width: 0; border: 0; padding: .7rem var(--space-4); font: inherit; background: transparent; color: var(--ink); outline: none; }
.button {
  border: 0;
  padding: .55rem 1.1rem;
  font: var(--weight-medium) var(--text-ui) var(--sans);
  background: var(--ink);
  color: var(--color-white);
  border-radius: var(--radius-sm);
  cursor: pointer;
}

.button:hover {
  background: var(--water);
}

.box button {
  border: 0;
  padding: 0 1.3rem;
  font: var(--weight-medium) var(--text-ui) var(--sans);
  background: var(--ink);
  color: var(--color-white);
  cursor: pointer;
}

.box button:hover {
  background: var(--water);
}
.channel { display: none; }

main { max-width: var(--content-default); margin: 0 auto; padding: var(--space-5); }
.lede { display: none; }
.status { color: var(--muted); font-size: var(--text-meta); min-height: 1.4rem; margin: var(--space-1) 0 var(--space-4); }
.status.error { color: var(--err); }
.status button { margin-left: var(--space-2); font: inherit; cursor: pointer; }

/* Wadiya home identity */
body.home {
  background:
    radial-gradient(circle at 50% 18%, rgba(79, 209, 197, .13), transparent 34rem),
    var(--bg);
}

body.home .top {
  flex-direction: column;
  justify-content: center;
  text-align: center;
  background: transparent;
  border: 0;
  min-height: 76vh;
  gap: 0;
  padding: 3rem var(--space-5) 2rem;
}

body.home .mark {
  margin-bottom: 1.8rem;
  font-size: clamp(3rem, 10vw, 5.25rem);
}

body.home .home-intro {
  max-width: 48rem;
  text-align: center;
}

body.home .home-intro h1 {
  margin: 0;
  color: var(--ink);
  font: var(--weight-regular) var(--text-display)/var(--line-tight) var(--serif);
  letter-spacing: -.035em;
}

body.home .home-copy {
  max-width: 38rem;
  margin: 1.15rem auto 0;
  color: var(--muted);
  font: var(--weight-regular) clamp(1rem, 2vw, 1.2rem)/1.55 var(--serif);
}

body.home .box {
  width: min(100%, var(--content-home));
  flex: 0 0 auto;
  margin-top: 1.35rem;
  padding: .3rem;
  border: var(--border-strong) solid var(--ink);
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 10px 30px rgba(14, 42, 48, .08);
}

body.home .box:focus-within {
  border-color: var(--water);
  box-shadow: var(--shadow-focus), 0 10px 30px rgba(14, 42, 48, .08);
}

body.home .box input {
  padding-left: 1rem;
}

body.home .box button {
  border-radius: var(--radius-pill);
  padding-inline: 1.2rem;
  font-weight: var(--weight-bold);
}

body.home .home-hint {
  max-width: 42rem;
  margin: .85rem 0 0;
  color: var(--muted);
  font-size: var(--text-sm);
  text-align: center;
}

body.home .channel {
  display: block;
  width: min(38rem, 90%);
  height: 24px;
  margin-top: 1.15rem;
  color: var(--water);
  opacity: .42;
}

body.home .lede {
  display: block;
  width: min(100% - 2rem, 42rem);
  margin: -1rem auto 3rem;
  text-align: center;
  color: var(--muted);
  font-family: var(--serif);
  font-style: normal;
  font-size: var(--text-lede);
  line-height: 1.6;
}

body.home .lede strong {
  display: block;
  margin-bottom: .15rem;
  color: var(--ink);
  font: var(--weight-medium) var(--text-display)/var(--line-heading) var(--serif);
}

/* Wadiya home philosophy */
body.home .home-philosophy {
  width: min(100% - 2rem, 42rem);
  margin: 0 auto var(--space-8);
  padding-top: var(--space-6);
  border-top: var(--border-thin) solid var(--line);
  color: var(--muted);
  text-align: center;
}

body.home .home-philosophy h2 {
  margin: 0 0 var(--space-3);
  color: var(--ink);
  font: var(--weight-medium) var(--text-heading)/var(--line-heading) var(--serif);
  letter-spacing: -.02em;
}

body.home .home-philosophy p {
  margin: 0 0 var(--space-3);
  line-height: 1.65;
}

body.home .home-philosophy ul {
  display: grid;
  gap: .45rem;
  margin: var(--space-5) auto;
  padding: 0;
  list-style: none;
}

body.home .home-philosophy li {
  color: var(--ink);
}

body.home .home-philosophy-tagline {
  margin-top: var(--space-5) !important;
  color: var(--ink);
  font-family: var(--serif);
}


body.home #pager,
body.home #results {
  display: none;
}

@media (max-width: 560px) {
  body.home .top {
    min-height: 78vh;
    padding: 2rem .75rem 1.5rem;
  }

  body.home .mark {
    margin-bottom: 1.8rem;
  }

  body.home .home-copy {
    margin-top: .9rem;
    font-size: 1rem;
  }

  body.home .box {
    margin-top: 1.5rem;
  }

  body.home .box input {
    min-width: 0;
    padding-left: .85rem;
    font-size: .95rem;
  }

  body.home .box button {
    padding-inline: 1rem;
  }

  body.home .home-hint {
    max-width: 22rem;
  }

  body.home .channel {
    margin-top: 1.4rem;
  }

  body.home .lede {
    margin-top: -1rem;
    margin-bottom: 2rem;
    font-size: .95rem;
  }
}

/* water fills the channel while a search is in flight */
.flow { position: fixed; top: 0; left: 0; height: 3px; width: 100%; background: linear-gradient(90deg, transparent, var(--water-bright), transparent); background-size: 40% 100%; background-repeat: no-repeat; animation: flow 1s linear infinite; z-index: 9; }
@keyframes flow { from { background-position: -40% 0; } to { background-position: 140% 0; } }
@media (prefers-reduced-motion: reduce) { .flow { animation: none; background: var(--water-bright); } }

/* Search result list — no browser-generated numbering */
.results {
  list-style: none;
  margin: 0;
  padding: 0;
}

.result { padding: .9rem 0; border-bottom: var(--border-thin) solid var(--line); }
.result .site { font-size: var(--text-sm); color: var(--muted); overflow-wrap: anywhere; }
.result .site b { color: var(--ink); font-weight: var(--weight-medium); }
.result h2 {
  margin: .2rem 0 .35rem;
  font: var(--weight-medium) clamp(1.45rem, 2.2vw, 1.75rem)/var(--line-title) var(--serif);
  letter-spacing: -.015em;
  overflow-wrap: anywhere;
}

.result h2 a {
  color: var(--water);
  text-decoration: none;
}

.result h2 a:hover {
  color: var(--ink);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}
.result p { margin: 0; color: var(--color-text-subtle); overflow-wrap: anywhere; }
mark { background: var(--color-highlight); color: inherit; border-radius: var(--radius-xs); padding: 0 1px; }
.discover-link {
  display: inline-block;
  margin-top: var(--space-3);
  padding: var(--space-1) var(--space-3);
  background: var(--color-action-soft);
  color: var(--color-text) !important;
  border-radius: var(--radius-sm);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
}

.discover-link:hover {
  background: var(--color-action-soft-hover);
}


.empty { padding: var(--space-7) 0; }
.empty h2 { font: var(--weight-medium) var(--text-heading) var(--serif); margin: 0 0 var(--space-2); }
.pager { display: flex; justify-content: space-between; align-items: center; padding: var(--space-5) 0 var(--space-8); font-size: var(--text-ui); }
.pager a, .pager span.off { padding: var(--space-2) var(--space-4); border: var(--border-thin) solid var(--line); border-radius: var(--radius-pill); background: var(--panel); text-decoration: none; }
.pager span.off { color: var(--line); }
.pager a:hover { border-color: var(--water); }

@media (max-width: 560px) {
  .top { padding: var(--space-3); } .mark { font-size: var(--text-heading); }
  .box { flex-basis: 100%; max-width: none; } main { padding: var(--space-3); }
  .result h2 { font-size: var(--text-md); }
}

/* Results as cards (mockup) */
body:not(.home) main { max-width: 52rem; }
.result {
  background: var(--color-white);
  border: 0;
  border-radius: 16px;
  padding: var(--space-5) var(--space-6);
  margin-bottom: var(--space-4);
  box-shadow: 0 1px 2px rgba(14, 42, 48, .06), 0 6px 18px rgba(14, 42, 48, .06);
}
.result .site { display: flex; align-items: center; gap: var(--space-2); }
.result .site .fav {
  flex: none;
  width: 16px;
  height: 16px;
  border-radius: 5px;
  background: linear-gradient(135deg, var(--color-primary) 50%, var(--color-primary-bright) 50%);
}
.result h2 { margin: .35rem 0; font-size: clamp(1.2rem, 1.8vw, 1.4rem); }
.result p {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.result .discover-link { float: right; margin-top: var(--space-3); border-radius: var(--radius-pill); padding: var(--space-1) var(--space-4); }
.result::after { content: ""; display: block; clear: both; }
.status { margin-top: var(--space-2); }
@media (max-width: 560px) {
  .result { padding: var(--space-4); border-radius: 14px; }
}

/* admin */
.admin main { max-width: var(--content-wide); }
.admin h1 { font: var(--weight-bold) var(--text-brand) var(--serif); } .admin h2 { font: var(--weight-medium) var(--text-md) var(--serif); margin: 1.6rem 0 var(--space-2); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .6rem; }
.card { background: var(--panel); border: var(--border-thin) solid var(--line); border-radius: var(--radius-md); padding: .6rem .8rem; }
.card .n { font: var(--weight-bold) var(--text-display) var(--serif); } .card .l { font-size: var(--text-xs); color: var(--muted); }
.admin table { width: 100%; border-collapse: collapse; font-size: var(--text-table); background: var(--panel); }
.admin th, .admin td { text-align: left; padding: .35rem .5rem; border-bottom: var(--border-thin) solid var(--line); overflow-wrap: anywhere; }
.tablewrap { overflow-x: auto; }
.login { max-width: var(--content-narrow); margin: 4rem auto; background: var(--panel); border: var(--border-thin) solid var(--line); border-radius: var(--radius-lg); padding: var(--space-6); }
.login input { width: 100%; padding: .6rem; margin: var(--space-2) 0 var(--space-4); font: inherit; border: var(--border-thin) solid var(--ink); border-radius: var(--radius-sm); }
.login button, .toolbar button {
  padding: .55rem 1.1rem;
  font: var(--weight-medium) var(--text-ui) var(--sans);
  background: var(--ink);
  color: var(--color-white);
  border: 0;
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.toolbar { display: flex; justify-content: space-between; align-items: center; }
.login h1 { margin-top: 0; }

/* =========================================================
   Website Discovery
   ========================================================= */

.discovery-main {
  max-width: var(--content-wide);
  margin: 0 auto;
  padding: var(--space-7) var(--space-5) var(--space-9);
}

.discovery-hero {
  padding: var(--space-7) 0 var(--space-6);
  border-bottom: var(--border-thin) solid var(--line);
}

.discovery-kicker {
  margin: 0 0 var(--space-2);
  color: var(--water);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: .08em;
  text-transform: uppercase;
}

.discovery-hero h1 {
  margin: 0;
  color: var(--ink);
  font: var(--weight-bold) var(--text-display)/var(--line-heading) var(--serif);
  overflow-wrap: anywhere;
}

.discovery-summary {
  margin: var(--space-3) 0 var(--space-4);
  color: var(--ink);
  font-size: var(--text-lede);
}

.discovery-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-6);
  color: var(--muted);
  font-size: var(--text-meta);
}

.discovery-pages {
  padding-top: var(--space-6);
}

.discovery-pages h2 {
  margin: 0 0 var(--space-3);
  font: var(--weight-medium) var(--text-heading)/var(--line-heading) var(--serif);
}

.discovery-list {
  margin: 0;
  padding: 0;
}

.discovery-page {
  padding: var(--space-5) 0;
  border-bottom: var(--border-thin) solid var(--line);
}

.discovery-number {
  margin-bottom: var(--space-2);
  color: var(--muted);
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
}

.discovery-page-title {
  display: inline-block;
  color: var(--ink);
  font: var(--weight-medium) var(--text-title)/var(--line-title) var(--serif);
  overflow-wrap: anywhere;
}

.discovery-page-title:hover {
  color: var(--water);
}

.discovery-url {
  margin-top: var(--space-1);
  color: var(--muted);
  font-size: var(--text-sm);
  overflow-wrap: anywhere;
}

.discovery-description {
  margin: var(--space-3) 0 0;
  color: var(--color-text-subtle);
  overflow-wrap: anywhere;
}

.discovery-details {
  margin-top: var(--space-2);
  color: var(--muted);
  font-size: var(--text-xs);
}

@media (max-width: 560px) {
  .discovery-main {
    padding: var(--space-5) var(--space-3) var(--space-8);
  }

  .discovery-hero {
    padding: var(--space-5) 0;
  }

  .discovery-meta {
    flex-direction: column;
    gap: var(--space-1);
  }

  .discovery-page {
    padding: var(--space-4) 0;
  }
}


/* ---------------------------------------------------------------
   Admin discovery dashboard
   --------------------------------------------------------------- */
.admin-discovery-page {
  max-width: 1440px;
  margin: 0 auto;
  padding: 2rem;
}

.admin-discovery-page .toolbar {
  align-items: flex-start;
}

.admin-discovery-page .toolbar a {
  color: inherit;
  text-decoration: none;
  font-size: 0.9rem;
}

.admin-discovery-filters {
  margin: 1.5rem 0;
  padding: 1rem;
  background: var(--color-white, #fff);
  border: 1px solid #dfe5e8;
  border-radius: 14px;
}

.admin-discovery-filters form {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
}

.admin-discovery-filters input,
.admin-discovery-filters select,
.admin-discovery-filters button {
  min-height: 2.6rem;
  border: 1px solid #d7dfe3;
  border-radius: 9px;
  padding: 0 0.8rem;
  background: #fff;
}

.admin-discovery-filters input {
  flex: 1 1 20rem;
}

.admin-discovery-filters button {
  cursor: pointer;
  font-weight: 600;
}

.admin-discovery-page .tablewrap {
  overflow-x: auto;
}

.admin-discovery-page table {
  min-width: 1200px;
}

.admin-discovery-page td {
  max-width: 360px;
  overflow-wrap: anywhere;
  vertical-align: top;
}

.admin-discovery-page td a {
  color: inherit;
}

.admin-discovery-page td:nth-child(4) {
  font-weight: 600;
}

@media (max-width: 700px) {
  .admin-discovery-page {
    padding: 1rem;
  }

  .admin-discovery-filters form {
    flex-direction: column;
  }

  .admin-discovery-filters input,
  .admin-discovery-filters select,
  .admin-discovery-filters button {
    width: 100%;
  }
}


/* Discovery dashboard pagination and admin navigation */
.admin-nav {
  margin: 0.45rem 0 0;
}

.admin-nav a {
  color: inherit;
  font-size: 0.9rem;
  text-decoration: none;
  opacity: 0.82;
}

.admin-nav a:hover {
  text-decoration: underline;
  opacity: 1;
}

.admin-discovery-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin: 1rem 0;
}

.admin-discovery-pagination > .status {
  margin: 0;
}

.admin-discovery-page-controls {
  display: flex;
  align-items: center;
  gap: 0.55rem;
}

.admin-discovery-page-controls button {
  min-height: 2.4rem;
  border: 1px solid #d7dfe3;
  border-radius: 9px;
  padding: 0 0.8rem;
  background: #fff;
  cursor: pointer;
  font-weight: 600;
}

.admin-discovery-page-controls button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

#pageInfo {
  min-width: 8rem;
  text-align: center;
  font-size: 0.9rem;
  font-weight: 600;
}

@media (max-width: 700px) {
  .admin-discovery-pagination {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-discovery-page-controls {
    justify-content: space-between;
  }

  #pageInfo {
    min-width: auto;
  }
}


/* Admin discovery — 1440px visual polish */
.admin-discovery-page {
  padding: 2.25rem 2rem 3rem;
}

.admin-discovery-page > .toolbar {
  margin-bottom: 1.5rem;
}

.admin-discovery-page > .toolbar h1 {
  margin: 0.35rem 0 0;
  letter-spacing: -0.025em;
}

.admin-discovery-page .cards {
  gap: 0.9rem;
  margin-bottom: 1.25rem;
}

.admin-discovery-page .card {
  border: 1px solid #e1e7ea;
  border-radius: 14px;
  box-shadow: 0 2px 8px rgba(23, 42, 70, 0.045);
  transition: border-color 160ms ease, box-shadow 160ms ease,
    transform 160ms ease;
}

.admin-discovery-page .card:hover {
  border-color: #d2dce1;
  box-shadow: 0 5px 16px rgba(23, 42, 70, 0.07);
  transform: translateY(-1px);
}

.admin-discovery-filters {
  margin: 1.25rem 0;
  padding: 1rem 1.1rem;
  border-color: #e1e7ea;
  box-shadow: 0 2px 8px rgba(23, 42, 70, 0.035);
}

.admin-discovery-filters form {
  align-items: center;
}

.admin-discovery-filters input,
.admin-discovery-filters select,
.admin-discovery-filters button {
  min-height: 2.75rem;
  border-color: #d8e0e4;
  transition: border-color 140ms ease, box-shadow 140ms ease;
}

.admin-discovery-filters input:focus,
.admin-discovery-filters select:focus {
  outline: none;
  border-color: #d7aeb2;
  box-shadow: 0 0 0 3px rgba(183, 45, 55, 0.08);
}

.admin-discovery-filters button {
